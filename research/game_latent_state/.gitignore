# Generated data. Excluded by rule, identified by hash.
#
# The OOF residual dataset is ~65 MB of derived data, more than twenty times
# the largest blob this repository otherwise tracks. Its SHA256 is recorded in
# SHA256SUMS.residuals.txt and residual_manifest.json, together with the
# raw-input fingerprints, seed and code SHA needed to rebuild it byte-for-byte
# with 02_build_oof_residuals.py.
#
# This branch was built fresh from the production base rather than by merging
# the research branches, so the residual blob is not reachable from it at all.
# On those research branches it is: the bytes were committed once, in 43e4d2a,
# before the exclusion landed, and removing them in 4e15feb left the object
# reachable from every descendant. Being untracked at a branch head only keeps
# a blob out of a *squash* merge; an ordinary merge commit carries the whole
# history. That is the difference this branch exists to avoid, and
# ops/audit_merge_path_blobs.py is what checks it rather than trusting it.
oof_gaussian_residuals.parquet

# The tabular loadings export and the graded joint events are regenerated by
# 03_fit_latent_factors.py and 04_validate_shadow_v1.py. Neither is an input
# to anything: factor_spec.json carries the full loadings payload, and the
# grades are summarised into validation_report.json. Their SHA256s are in
# SHA256SUMS.factors.txt and SHA256SUMS.validation.txt.
factor_loadings.parquet
joint_event_grades.parquet
