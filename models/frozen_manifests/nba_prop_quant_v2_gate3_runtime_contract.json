{
  "auto_bet": false,
  "contract_name": "nba_prop_quant_v2_gate3_runtime_contract",
  "contract_version": 1,
  "description": "Declarative deployment-integrity contract for the already-frozen NBA Prop Quant v2 / Gate 3 model. This file lists which resources belong to the hosted production runtime; it does not define statistical behaviour and contains no hashes of binary model artifacts, which are distributed outside git and hashed by the bundle builder at build time.",
  "excluded_development_resources": [
    {
      "path": "data/processed/oof_selected_means.parquet",
      "reason": "Development out-of-fold mean predictions. Not read by scripts/10_predict_slate.py or scripts/15_price_markets.py."
    },
    {
      "path": "data/processed/selected_means_distribution_split.parquet",
      "reason": "Development distribution-fitting split. Only an input to historical fitting/certification, never to live inference."
    },
    {
      "path": "data/processed/market_backtest/**",
      "reason": "2025 retrospective market backtest evidence. Live pricing reads no backtest output."
    },
    {
      "path": "research/v2_gate2_certification_outputs/**",
      "reason": "Gate 2 certification evidence. Its SHA256SUMS group is verified at build time, but nothing under it is loaded at runtime."
    },
    {
      "path": "data/raw/seasons/**/games.parquet",
      "reason": "load_history_box_stats() globs stats.parquet only; upcoming games arrive from the prospective snapshot, not from historical raw games."
    },
    {
      "path": "data/snapshots/**",
      "reason": "Mutable append-only prospective capture stream. Runtime state, not a frozen model artifact."
    },
    {
      "path": "data/processed/projections/**",
      "reason": "Mutable per-slate output written by scripts/10_predict_slate.py."
    },
    {
      "path": "data/processed/priced_markets/**",
      "reason": "Mutable per-slate output written by scripts/15_price_markets.py."
    },
    {
      "path": "data/validation/**",
      "reason": "Development QA and audit evidence."
    },
    {
      "path": "src/nba_prop_quant/ctmc.py",
      "reason": "Not in the import closure of the production prediction/pricing entry points."
    },
    {
      "path": "src/nba_prop_quant/ingest.py",
      "reason": "Historical ingestion tooling; not in the runtime import closure."
    },
    {
      "path": "src/nba_prop_quant/interpret.py",
      "reason": "Explanation tooling used by scripts/16_explain_projection.py; not in the runtime import closure."
    },
    {
      "path": "src/nba_prop_quant/live.py",
      "reason": "In-game live tooling; not in the runtime import closure."
    },
    {
      "path": "src/nba_prop_quant/market.py",
      "reason": "Not in the runtime import closure."
    },
    {
      "path": "src/nba_prop_quant/sequence.py",
      "reason": "Optional torch sequence research module; not in the runtime import closure."
    }
  ],
